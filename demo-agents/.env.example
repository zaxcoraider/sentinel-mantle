# Which network the demo agents act on: mainnet (default) | sepolia
DEMO_NETWORK=mainnet

# Deployer wallet — used by setup.ts to mint NFTs, deploy SafetyRules, register agents, fund guards.
# Must have MNT on the selected network (≥0.05 MNT; more if you raise GUARD_DEPOSIT_MNT).
DEPLOYER_PRIVATE_KEY=0x...

# Monitor wallet — used by manual-trigger.ts to fire circuit breakers.
# MUST be the wallet registered as the monitor in SentinelGuard on the selected network
# (mainnet monitor = 0xbD729a358543933c3C83707E1038e3a409E2Cf43).
MONITOR_PRIVATE_KEY=0x...

# RPC overrides (optional). Defaults: mainnet https://rpc.mantle.xyz · sepolia https://rpc.sepolia.mantle.xyz
MANTLE_RPC_URL=
MANTLE_SEPOLIA_RPC_URL=

# Optional MNT amounts (defaults shown). GUARD_DEPOSIT_MNT becomes each agent's
# protected balance (the site's "MNT Protected" total = sum across agents).
GAS_BUDGET_MNT=0.005
GUARD_DEPOSIT_MNT=0.02
