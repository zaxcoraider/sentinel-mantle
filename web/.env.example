# ── Sentinel web — environment template ──────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit .env.local.

# RPC — server-side (no NEXT_PUBLIC_ prefix → not exposed to the browser)
MANTLE_SEPOLIA_RPC_URL=https://rpc.sepolia.mantle.xyz

# RPC — client-side (exposed to the browser via wagmi)
NEXT_PUBLIC_MANTLE_SEPOLIA_RPC_URL=https://rpc.sepolia.mantle.xyz
NEXT_PUBLIC_MANTLE_RPC_URL=https://rpc.mantle.xyz

# WalletConnect project ID — get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=demo

# Chain selector (5000 = Mantle Mainnet, 5003 = Sepolia)
NEXT_PUBLIC_CHAIN_ID=5000

# Monitor URL (for /events SSE and /health — used by the /watch page)
NEXT_PUBLIC_MONITOR_URL=http://localhost:8080

# App URL (for OG image base URL)
NEXT_PUBLIC_APP_URL=https://agentsentinel.space

# DGrid AI gateway — powers the plain-English rule parser (server-side only).
# Generate a key at https://dgrid.ai/api-keys. OpenAI-compatible endpoint.
DGRID_API_KEY=
DGRID_BASE_URL=https://api.dgrid.ai/v1
DGRID_MODEL_SMART=anthropic/claude-sonnet-4.6
DGRID_MODEL_FAST=anthropic/claude-haiku-4.5
